# Base URL of the API gateway (all services live under /api/v1).
# Leave empty to use the default: "/api/v1" in development (proxied) and
# "https://api.mimir-ai.hu/api/v1" in production builds.
VITE_API_BASE_URL=

# "v1" = topic workspace against the /api/v1 contract (openapi/mimir-public.yaml).
# "legacy" = the old single-document chat for the current backend.
# Default: v1 in development, legacy in production builds (so the live site keeps working).
VITE_API_MODE=

# true = answer the v1 API from the in-browser mock (MSW); no backend needed.
# Default: true in development when VITE_API_MODE is v1, false in production builds.
VITE_USE_MOCKS=

# Where `npm run dev` proxies /api requests (the local gateway from docker compose).
VITE_DEV_PROXY_TARGET=http://localhost:80

# Email address for data protection requests, shown on the "Your data" page.
VITE_PRIVACY_EMAIL=
