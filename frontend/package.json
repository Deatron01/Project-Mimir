{
  "name": "mimir-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:legacy": "vite --mode legacy",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:a11y": "playwright test e2e/a11y.spec.ts",
    "api:types": "openapi-typescript openapi/mimir-public.yaml -o src/api/schema.d.ts --default-non-nullable false",
    "check:api": "node scripts/check-api-types.mjs",
    "theme:build": "node scripts/generate-theme-css.mjs",
    "check:theme": "node scripts/generate-theme-css.mjs --check && node scripts/check-contrast.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check": "npm run check:theme && npm run check:i18n && npm run check:api && npm run typecheck && npm run lint",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@tanstack/react-query": "^5.103.2",
    "clsx": "^2.1.0",
    "framer-motion": "^11.0.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.363.0",
    "openapi-fetch": "^0.17.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.15",
    "react-router-dom": "^6.22.3",
    "tailwind-merge": "^2.2.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^9.1.20",
    "@storybook/react-vite": "^9.1.20",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^2.0.7",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.38",
    "storybook": "^9.1.20",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^5.2.0",
    "vitest": "^3.2.7"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
